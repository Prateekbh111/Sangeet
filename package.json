{
  "name": "beatsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BeatSync — sync YouTube Music playback across devices (Brave/Chromium MV3 extension)",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "dev": "concurrently -n server,ext -c blue,green -k --restart-tries 3 \"npm:server:watch\" \"npm:build:watch\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
